{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex"
  ],
  "includePaths": [
    ".github/workflows/release-macos.yml"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/release-macos\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+java-version: \\\"(?<currentValue>\\d+)\\\""
      ],
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "JetBrains/JetBrainsRuntime"
      ],
      "extractVersion": "^jbr-release-(?<version>\\d+)"
    }
  ]
}
